# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://gearvault:gearvault_dev_password@localhost:5432/gearvault
# DATABASE_POOLER_URL=postgresql://...

# Authentication
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# S3 / MinIO Object Storage
S3_BUCKET=gearvault-media
AWS_REGION=us-east-1
# S3_ENDPOINT_URL is dev-only (points to local MinIO). Leave UNSET in production AWS S3.
S3_ENDPOINT_URL=http://localhost:9000
# AWS keys are dev-only (MinIO). In AWS production, leave UNSET to use IAM Role / default credential chain.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# MEDIA_BASE_URL=https://<domain>/media

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Reverse Proxy / ALB / CloudFront Settings
# PROXY_FIX_FOR: Number of reverse proxy hops to trust for X-Forwarded-For (default: 2 for CloudFront + ALB).
PROXY_FIX_FOR=2
PROXY_FIX_PROTO=1
PROXY_FIX_HOST=1

# Rate Limiter Notes:
# Limiter storage is default in-memory per worker.
# For distributed multi-instance deployment with shared limits, configure RATELIMIT_STORAGE_URI (e.g. redis://...).

# Application Settings
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Seeding (Optional)
SEED_DEV_USERS=false
# DEV_USERS_PASSWORD=dev_password_here
