# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://gearvault:gearvault_dev_password@localhost:5432/gearvault
# DATABASE_POOLER_URL=postgresql://...

# Authentication
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# S3 / MinIO Object Storage
S3_BUCKET=gearvault-media
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# MEDIA_BASE_URL=https://cdn.example.com/items

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Application Settings
LOG_LEVEL=INFO
WEB_CONCURRENCY=2

# Seeding (Optional)
SEED_DEV_USERS=false
# DEV_USERS_PASSWORD=dev_password_here
